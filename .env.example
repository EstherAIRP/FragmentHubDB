# GitHub OAuth — user authentication, server side only
FragmentHubDB_GITHUB_CLIENT_ID=
FragmentHubDB_GITHUB_CLIENT_SECRET=
FragmentHubDB_PUBLIC_URL=
FragmentHubDB_SESSION_SECRET=
# Comma-separated immutable numeric GitHub user IDs.
FragmentHubDB_ALLOWED_GITHUB_IDS=

# GitHub Remote Store — canonical Fragment data, server side only
# Fine-grained token must have Contents: Read and write on EstherAIRP/FragmentHubDB.
FragmentHubDB_GITHUB_TOKEN=

# Optional: these defaults are already used by the application.
FragmentHubDB_GITHUB_REPOSITORY=EstherAIRP/FragmentHubDB
FragmentHubDB_GITHUB_BRANCH=main

# Canonical Fragment backend: mongodb | github | local
# Must be explicitly set to mongodb AFTER data import and verification.
# When omitted, the legacy GitHub-token/local behavior is preserved.
# FragmentHubDB_DATA_STORE=github

# MongoDB Atlas, server side only: DO NOT prefix with NEXT_PUBLIC_.
# Use this project-specific URI only; do not share a generic MONGODB_URI.
FragmentHubDB_MONGODB_URI=
FragmentHubDB_MONGODB_DATABASE=fragmenthubdb
